# APP
APP_ENV=staging
NODE_ENV=production
PORT=3003
HOST=0.0.0.0
FRONTEND_URL=https://staging.amanzi-ats.com

# DATABASE
DB_HOST=staging-db.internal
DB_PORT=5432
DB_NAME=amanzi_staging
DB_USER=staging_user
DB_PASSWORD=staging_password_secure
DATABASE_URL=postgresql://staging_user:staging_password_secure@staging-db.internal:5432/amanzi_staging

# AUTH & SECURITY
JWT_SECRET=super_secret_staging_jwt_key_that_is_at_least_32_chars!
REFRESH_TOKEN_SECRET=super_secret_staging_refresh_key_that_is_at_least_32_chars!
SECURE_BROWSER_INGEST_TOKEN=secure_browser_ingest_token_32_chars

# WORKER & AI
PYTHON_WORKER_BASE_URL=http://worker-staging:8001
WORKER_API_HOST=worker-staging
WORKER_API_PORT=8001
GEMINI_API_KEY=your_staging_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ELASTICSEARCH
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://elasticsearch-staging:9200

# REDIS
REDIS_ENABLED=true
REDIS_HOST=redis-staging
REDIS_PORT=6379

# LOGGING
APP_LOG_LEVEL=info
LOG_LEVEL=info
LOG_SENSITIVE_DEV_DETAILS=false
