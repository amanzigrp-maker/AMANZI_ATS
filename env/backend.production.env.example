# PostgreSQL Database Configuration
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-secure-db-password
DB_NAME=amanzi_data_production

# JWT Secret for authentication (must be at least 32 characters long)
# Use underscores or non-alphanumeric characters to prevent triggering VCS secret leak warnings
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARACTERS
REFRESH_TOKEN_SECRET=YOUR_PRODUCTION_REFRESH_TOKEN_SECRET_MUST_BE_AT_LEAST_32_CHARACTERS

# Application Environment
NODE_ENV=production
APP_ENV=production

# Frontend URL for OAuth redirects and CORS configurations
FRONTEND_URL=https://your-production-domain.com

# Email Configuration for Password Reset (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-user@gmail.com
EMAIL_PASSWORD=your-smtp-app-password
EMAIL_FROM_NAME=Amanzi Tech

# Python Worker Configuration
PYTHON_WORKER_BASE_URL=http://127.0.0.1:8001
WORKER_API_HOST=127.0.0.1
WORKER_API_PORT=8001

# Gemini AI Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Redis Configuration (Optional, default disabled)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Configuration (Optional, default disabled)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_RESUMES=ats_resumes
ELASTICSEARCH_INDEX_JOBS=ats_jobs
ELASTICSEARCH_INDEX_CANDIDATES=ats_candidates

# Sentry Monitoring (Optional)
SENTRY_DSN=
