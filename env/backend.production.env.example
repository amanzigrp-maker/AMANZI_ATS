# APP
APP_ENV=production
NODE_ENV=production
PORT=3003
HOST=0.0.0.0
FRONTEND_URL=https://amanzi-ats.com

# DATABASE
DB_HOST=prod-db.internal
DB_PORT=5432
DB_NAME=amanzi_prod
DB_USER=prod_user
DB_PASSWORD=prod_password_secure
DATABASE_URL=postgresql://prod_user:prod_password_secure@prod-db.internal:5432/amanzi_prod

# AUTH & SECURITY
JWT_SECRET=super_secret_production_jwt_key_that_is_at_least_32_chars!
REFRESH_TOKEN_SECRET=super_secret_production_refresh_key_that_is_at_least_32_chars!
SECURE_BROWSER_INGEST_TOKEN=secure_browser_ingest_token_32_chars

# WORKER & AI
PYTHON_WORKER_BASE_URL=http://worker-prod:8001
WORKER_API_HOST=worker-prod
WORKER_API_PORT=8001
GEMINI_API_KEY=your_production_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ELASTICSEARCH
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://elasticsearch-prod:9200

# REDIS
REDIS_ENABLED=true
REDIS_HOST=redis-prod
REDIS_PORT=6379

# LOGGING
APP_LOG_LEVEL=warn
LOG_LEVEL=warn
LOG_SENSITIVE_DEV_DETAILS=false
