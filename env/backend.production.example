APP_ENV=production
NODE_ENV=production

PORT=3003
HOST=0.0.0.0
FRONTEND_URL=https://app.example.com
PYTHON_WORKER_BASE_URL=https://worker.example.com
WORKER_API_HOST=127.0.0.1
WORKER_API_PORT=8001

DB_HOST=production-db.internal
DB_PORT=5432
DB_NAME=amanzi_production
DB_USER=amanzi_app
DB_PASSWORD=inject-from-secret-manager

JWT_SECRET=inject-from-secret-manager-at-least-32-characters
REFRESH_TOKEN_SECRET=inject-from-secret-manager-at-least-32-characters
SECURE_BROWSER_INGEST_TOKEN=inject-from-secret-manager-at-least-32-characters

REDIS_ENABLED=true
REDIS_HOST=production-redis.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=inject-from-secret-manager

GEMINI_API_KEY=inject-from-secret-manager
GEMINI_MODEL=gemini-1.5-flash

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=inject-from-secret-manager
EMAIL_PASSWORD=inject-from-secret-manager
EMAIL_FROM_NAME=Amanzi

ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=https://production-elasticsearch.example.com
