# APP
APP_ENV=local
NODE_ENV=development
PORT=3003
HOST=0.0.0.0
FRONTEND_URL=http://localhost:8080

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amanzi_ats
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amanzi_ats

# AUTH & SECURITY
JWT_SECRET=super_secret_local_jwt_key_that_is_at_least_32_chars!
REFRESH_TOKEN_SECRET=super_secret_local_refresh_key_that_is_at_least_32_chars!
SECURE_BROWSER_INGEST_TOKEN=secure_browser_ingest_token_32_chars

# WORKER & AI
PYTHON_WORKER_BASE_URL=http://127.0.0.1:8001
WORKER_API_HOST=127.0.0.1
WORKER_API_PORT=8001
GEMINI_API_KEY=your_local_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ELASTICSEARCH
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200

# REDIS
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# LOGGING
APP_LOG_LEVEL=debug
LOG_LEVEL=debug
LOG_SENSITIVE_DEV_DETAILS=true
